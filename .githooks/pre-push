#!/usr/bin/env bash
# Runs `mix check --fast` (CI's fast gates, without docs) before a push.
#
#   SKIP_CHECK=1 git push ...    push without running it
#
# scripts/install-git-helpers (run by scripts/worktree-setup) copies this file
# out of the tree and points core.hooksPath at the copy, which also serves
# trees on older branches, so it passes --passed only to a scripts/check whose
# --help mentions it. It checks the working tree, not the pushed commits, so
# commit or set aside unrelated changes first. That check is the tree's own
# scripts/check, so pushing runs the checked-out branch's code, as `mix check`
# does.
#
# When the check passes on a clean working tree, the hook records HEAD's tree
# in .git (brando-check-passed, per worktree). A later push from a clean tree
# that changes only changelog fragments and Markdown no gate reads since then
# runs only the changelog check.
[ "${SKIP_CHECK:-}" = 1 ] && exit 0

# Deleting a remote branch pushes nothing to check.
pushing=false
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  case "$local_sha" in *[!0]*) pushing=true ;; esac
done
[ "$pushing" = true ] || exit 0

cd "$(git rev-parse --show-toplevel)" || exit 1
# Git runs hooks with GIT_DIR (and in worktrees GIT_WORK_TREE, GIT_INDEX_FILE)
# set to this repository. A gate that builds a scratch repository would then
# commit and push in this one, so the gates run without them.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_IMPLICIT_WORK_TREE
[ -x scripts/check ] || exit 0

passed_file="$(git rev-parse --git-path brando-check-passed)"
passed=()
if [ -s "$passed_file" ] && scripts/check --help 2>/dev/null | grep -q -- --passed; then
  passed=(--passed "$(cat "$passed_file")")
fi
tree="$(git rev-parse "HEAD^{tree}")"
clean=false
[ -z "$(git status --porcelain --untracked-files=normal)" ] && clean=true

if ! scripts/check --fast ${passed[@]+"${passed[@]}"}; then
  echo "pre-push: mix check --fast failed. Fix it, or push anyway with SKIP_CHECK=1." >&2
  exit 1
fi
if [ "$clean" = true ]; then
  echo "$tree" >"$passed_file"
fi
