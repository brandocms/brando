export BRANDO_DEFAULT_LANGUAGE="en"
export BRANDO_DB_URL="postgres://postgres:postgres@localhost/e2e_project_dev"
export BRANDO_SECRET_KEY_BASE="M3ffNRpzbTeTfFibxAXlTdeQLVYVL2Fr6XBogK/3YJuvC08Xn5XZcPW9tzk2t/Kp"

# Keep every Git worktree on its own E2E database and HTTP port. cksum is
# specified by POSIX and available on both macOS and GitHub's Linux runners.
# Set BRANDO_E2E_INSTANCE, BRANDO_E2E_DATABASE, or BRANDO_E2E_PORT before
# sourcing this file to override any derived value.
brando_e2e_worktree_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)"
brando_e2e_worktree_checksum="$(printf '%s' "$brando_e2e_worktree_root" | cksum | awk '{print $1}')"
export BRANDO_E2E_INSTANCE="${BRANDO_E2E_INSTANCE:-$brando_e2e_worktree_checksum}"

brando_e2e_instance_slug="$(printf '%s' "$BRANDO_E2E_INSTANCE" | LC_CTYPE=C tr -c 'a-zA-Z0-9_' '_')"
export BRANDO_E2E_DATABASE="${BRANDO_E2E_DATABASE:-e2e_project_test_${brando_e2e_instance_slug}}"

brando_e2e_instance_checksum="$(printf '%s' "$BRANDO_E2E_INSTANCE" | cksum | awk '{print $1}')"
export BRANDO_E2E_PORT="${BRANDO_E2E_PORT:-$((20000 + brando_e2e_instance_checksum % 10000))}"

export BRANDO_URL_SCHEME="http"
export BRANDO_URL_HOST="localhost"
export BRANDO_URL_PORT="$BRANDO_E2E_PORT"
export BRANDO_E2E_BASE_URL="${BRANDO_URL_SCHEME}://${BRANDO_URL_HOST}:${BRANDO_E2E_PORT}"

export PORT="$BRANDO_E2E_PORT"

unset brando_e2e_worktree_root
unset brando_e2e_worktree_checksum
unset brando_e2e_instance_slug
unset brando_e2e_instance_checksum
