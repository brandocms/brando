#!/usr/bin/env bash
# Checks and collates the changelog fragments in changelog.d/ (the format is in
# changelog.d/README.md). Prints one summary line, or one line per problem.
#
#   scripts/changelog check     validate every fragment (mix check and CI)
#   scripts/changelog collate   validate, then move every fragment into the
#                               unreleased section of CHANGELOG.md
#
# Collating puts each section's fragments, in file name order, at the top of
# the first heading of that section under the first `## ` heading, which must
# say "Unreleased"; a section the release has no heading for yet gets one at
# the end of the unreleased section. An entry whose bold lead has no PR number
# gets the one of the pull request that merged its fragment into the branch:
# `**Lead.** Text` becomes `**Lead** (#N). Text`. The fragments are deleted;
# commit the result.
#
#   CHANGELOG_FILE       the changelog to collate into (default CHANGELOG.md)
#   CHANGELOG_FRAGMENTS  the fragments directory (default changelog.d)
set -uo pipefail

# Section keys (the second-to-last part of a fragment's file name) and the
# CHANGELOG headings they collate under, in the order the headings appear.
keys="breaking improvements features fixes dependencies security"
titles="Breaking Improvements Features Fixes Dependencies Security"

usage() {
  echo "usage: scripts/changelog check|collate" >&2
  exit 1
}

root="$(cd "$(dirname "$0")/.." && pwd)"
changelog="${CHANGELOG_FILE:-$root/CHANGELOG.md}"
fragments="${CHANGELOG_FRAGMENTS:-$root/changelog.d}"

[ $# -eq 1 ] || usage
case "$1" in
  check|collate) command="$1" ;;
  -h|--help) awk 'NR > 1 && !/^#/ { exit } NR > 1 { sub(/^# ?/, ""); print }' "$0"; exit 0 ;;
  *) usage ;;
esac

# Every fragment file, in collation order. Dotfiles and the README are not
# fragments.
list_fragments() {
  [ -d "$fragments" ] || return 0
  find "$fragments" -mindepth 1 -maxdepth 1 ! -name '.*' ! -name README.md -print |
    sed 's|.*/||' | LC_ALL=C sort
}

# section_of <file name>: the section key, or nothing when the name is not
# <name>.<section>.md with a known section.
section_of() {
  local name="$1" section
  case "$name" in
    *.md) ;;
    *) return 0 ;;
  esac
  section="${name%.md}"
  section="${section##*.}"
  [ "${name%."$section".md}" != "$name" ] || return 0
  case "${name%."$section".md}" in
    ''|[!A-Za-z0-9]*|*[!A-Za-z0-9._-]*) return 0 ;;
  esac
  case " $keys " in
    *" $section "*) echo "$section" ;;
  esac
}

# An awk function both programs share: whether the line opens or closes a
# code fence, keeping the open fence in `fenced` (empty outside one). A fence
# closes only on the same character, at least as long, with nothing after it.
fence_awk='
  function fence(   marker, rest) {
    if (!match($0, /^ *(```+|~~~+)/)) return 0
    marker = substr($0, RSTART, RLENGTH)
    sub(/^ */, "", marker)
    rest = substr($0, RSTART + RLENGTH)
    if (fenced == "") {
      if (substr(marker, 1, 1) == "`" && index(rest, "`")) return 0
      fenced = marker
      return 1
    }
    if (substr(marker, 1, 1) != substr(fenced, 1, 1)) return 0
    if (length(marker) < length(fenced) || rest !~ /^[ \t]*$/) return 0
    fenced = ""
    return 1
  }
'

# check_text <path>: one "<path>: <problem>" line per problem with its text.
check_text() {
  awk -v path="$1" "$fence_awk"'
    !/^[ \t]*$/ && !seen {
      seen = 1
      if ($0 !~ /^- /) print path ": the first line is not a list entry starting with \"- \""
    }
    fence() { next }
    fenced == "" && /^(   |  | )?#+([ \t]|$)/ {
      print path ":" NR ": a heading; the file name sets the section, the text holds list entries"
    }
    END {
      if (!seen) print path ": empty"
      if (fenced != "") print path ": a code fence is not closed"
    }
  ' "$1"
}

validate() {
  local name section problems count=0 failed=0
  problems="$(
    list_fragments | while IFS= read -r name; do
      section="$(section_of "$name")"
      if [ -z "$section" ]; then
        echo "$fragments/$name: not named <name>.<section>.md with a section of: $keys"
      elif [ ! -f "$fragments/$name" ]; then
        echo "$fragments/$name: not a file"
      else
        check_text "$fragments/$name"
      fi
    done
  )"
  count="$(list_fragments | wc -l | tr -d ' ')"
  if [ -n "$problems" ]; then
    echo "$problems"
    failed="$(echo "$problems" | sed 's/: .*//; s/:[0-9]*$//' | sort -u | wc -l | tr -d ' ')"
    echo "changelog: $failed of $count fragment(s) need fixing (see changelog.d/README.md)" >&2
    return 1
  fi
  fragment_count="$count"
}

fragment_count=0
validate || exit 1

if [ "$command" = check ]; then
  echo "changelog: $fragment_count fragment(s) valid"
  exit 0
fi

if [ "$fragment_count" -eq 0 ]; then
  echo "changelog: no fragments to collate"
  exit 0
fi

work="$(mktemp -d "${TMPDIR:-/tmp}/changelog.XXXXXX")"
trap 'rm -rf "$work"' EXIT

# "<file name> <commit>" for each fragment file, the commit that last added it
# on HEAD's history. Empty outside a Git repository.
git -C "$fragments" log --no-renames --diff-filter=A --name-only --format='commit %H' -- . 2>/dev/null |
  awk '/^commit / { commit = $2; next } NF { sub(/.*\//, ""); if (!seen[$0]++) print $0, commit }' \
  > "$work/.added"

# pr_of <file name>: the number of the pull request that brought the fragment
# into this branch: the first merge after the commit that added it, on the
# way to HEAD, whose first parent lacks that commit and whose subject is
# "Merge pull request #N from …". Nothing when there is none yet.
pr_of() {
  local added merge subject
  added="$(awk -v name="$1" '$1 == name { print $2; exit }' "$work/.added")"
  [ -n "$added" ] || return 0
  git -C "$fragments" rev-list --ancestry-path --merges --topo-order --reverse "$added..HEAD" 2>/dev/null |
    while read -r merge; do
      git -C "$fragments" merge-base --is-ancestor "$added" "$merge^1" && continue
      subject="$(git -C "$fragments" log -1 --format=%s "$merge")"
      case "$subject" in
        "Merge pull request #"*" from "*)
          subject="${subject#Merge pull request #}"
          echo "${subject%% *}"
          break
          ;;
      esac
    done
}

# number_entries <PR number>: the fragment on stdin, with (#N) after the bold
# lead of each entry whose lead has no number, inside the bold or right after
# it. A full stop ending the lead moves after the number.
number_entries() {
  awk -v pr="$1" "$fence_awk"'
    fence() { print; next }
    fenced != "" || pr == "" { print; next }
    /^[ \t]*$/ { open = 0 }
    /^- / { open = /^- \*\*/; from = 5 }
    open {
      i = index(substr($0, from), "**")
      if (i) {
        open = 0
        at = from + i - 1
        before = substr($0, 1, at - 1)
        after = substr($0, at + 2)
        if (before !~ /\(#[0-9]+\)$/ && after !~ /^ *\(#[0-9]+\)/) {
          if (before ~ /\.$/) $0 = substr(before, 1, length(before) - 1) "** (#" pr ")." after
          else $0 = before "** (#" pr ")" after
        }
      } else {
        from = 1
      }
    }
    { print }
  '
}

# One file per section: its fragments in name order, each without leading or
# trailing blank lines, separated by one blank line.
list_fragments | while IFS= read -r name; do
  section="$(section_of "$name")"
  pr="$(pr_of "$name")"
  [ -n "$pr" ] || echo "$name" >> "$work/.unnumbered"
  [ -s "$work/$section" ] && echo >> "$work/$section"
  number_entries "$pr" < "$fragments/$name" | awk '
    /^[ \t]*$/ { if (started) blanks++; next }
    { for (; blanks > 0; blanks--) print ""; started = 1; print }
  ' >> "$work/$section"
done

awk -v dir="$work" -v keys="$keys" -v titles="$titles" "$fence_awk"'
  # Adds the sections the release has no heading for, at the end of it.
  function flush(   i, added) {
    for (i = 1; i <= n; i++) {
      if (!(key[i] in text) || (key[i] in done)) continue
      if (last != "") print ""
      print "#### " title[i]
      print ""
      print text[key[i]]
      last = "x"
      done[key[i]] = 1
      added = 1
    }
    return added
  }
  BEGIN {
    n = split(keys, key, " ")
    split(titles, title, " ")
    for (i = 1; i <= n; i++) {
      key_of[title[i]] = key[i]
      file = dir "/" key[i]
      if ((getline line < file) > 0) {
        text[key[i]] = line
        while ((getline line < file) > 0) text[key[i]] = text[key[i]] "\n" line
        close(file)
      }
    }
  }
  skip_blank { skip_blank = 0; if ($0 == "") next }
  fence() { print; last = $0; next }
  fenced == "" && /^## / && state == 0 {
    if ($0 !~ /Unreleased/) { bad = 1; exit }
    state = 1; print; last = $0; next
  }
  fenced == "" && /^## / && state == 1 { if (flush()) print ""; state = 2 }
  fenced == "" && state == 1 && /^#### / {
    heading = substr($0, 6)
    sub(/[ \t]+$/, "", heading)
    k = key_of[heading]
    if (k != "" && (k in text) && !(k in done)) {
      print; print ""; print text[k]; print ""
      done[k] = 1; skip_blank = 1; last = ""
      next
    }
  }
  { print; last = $0 }
  END {
    if (bad || state == 0) exit 2
    if (state == 1) flush()
  }
' "$changelog" > "$work/CHANGELOG.md"
status=$?
if [ "$status" -eq 2 ]; then
  echo "changelog: the first ## heading in $changelog is not an Unreleased release; start one, then collate" >&2
  exit 1
elif [ "$status" -ne 0 ]; then
  exit "$status"
fi

cat "$work/CHANGELOG.md" > "$changelog" || exit 1
list_fragments | while IFS= read -r name; do rm -f "$fragments/$name"; done
echo "changelog: collated $fragment_count fragment(s) into $(basename "$changelog")"
if [ -s "$work/.unnumbered" ] && git -C "$fragments" rev-parse --is-inside-work-tree > /dev/null 2>&1; then
  echo "changelog: no pull request merged these yet, so their entries keep the PR numbers they had: $(tr '\n' ' ' < "$work/.unnumbered" | sed 's/ $//')"
fi
