<div class="content-list-wrapper">
  <article
    id={"listing-#{@listing.name}"}
    class="content-list"
    phx-hook="Brando.Listing"
    data-target={@myself}
  >
    <.tools
      schema={@schema}
      listing={@listing}
      active_filter={@active_filter}
      active_sort={@active_sort}
      sortable?={@sortable?}
      list_opts={@list_opts}
      hidden_filters={@hidden_filters}
      content_language={@content_language}
      exports={@listing.exports}
      select_export={JS.push("export", target: @myself)}
      update_status={JS.push("update_status", target: @myself)}
      update_filter={JS.push("update_filter", target: @myself)}
      update_sort={JS.push("update_sort", target: @myself)}
      next_filter_key={JS.push("next_filter_key", target: @myself)}
      delete_filter={JS.push("delete_filter", target: @myself)}
      toggle_boolean_filter={JS.push("toggle_boolean_filter", target: @myself)}
      update_select_filter={JS.push("update_select_filter", target: @myself)}
      reset_filters={JS.push("reset_filters", target: @myself)}
    />

    {render_slot(@column_header)}

    <.entries
      :let={entry}
      target={@myself}
      listing_name={@listing.name}
      entries={@entries.entries}
      pagination_meta={@entries.pagination_meta}
    >
      <:empty>
        <div :if={@empty_title} class="workspace-empty">
          <h3>{@empty_title}</h3><p>{@empty_description}</p>
        </div>
        <div :if={!@empty_title} class="empty-list">
          <figure>
            <.icon name="circle" />
          </figure>
          {gettext("No matching entries found")}
        </div>
      </:empty>

      <.live_component
        module={Row}
        id={"list-row-#{@singular}-#{entry.id}"}
        active_sort={@active_sort}
        entry={entry}
        sortable?={@sortable?}
        status?={@status?}
        alternates?={@alternates?}
        creator?={@creator?}
        listing={@listing}
        schema={@schema}
        selected_rows={@selected_rows}
        content_language={@content_language}
        current_user={@current_user}
        target={@myself}
        click_event="select_row"
      />
    </.entries>

    <.pagination
      :if={@entries.pagination_meta.total_entries > 0}
      pagination_meta={@entries.pagination_meta}
      change_page={JS.push("change_page", target: @myself)}
      change_limit={JS.push("change_limit", target: @myself)}
    />
  </article>

  <.selected_rows
    content_language={@content_language}
    schema={@schema}
    selected_rows={@selected_rows}
    selection_actions={visible_actions(@listing.selection_actions ++ @extra_selection_actions, @current_user)}
    target={@myself}
  />

  <.translation_dialog
    :if={@translation_dialog}
    dialog={@translation_dialog}
    target={@myself}
  />
</div>
