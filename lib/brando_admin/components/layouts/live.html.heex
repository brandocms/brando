<%= if @current_user do %>
  {live_render(@socket, BrandoAdmin.Chrome,
    id: "brando-chrome",
    session: %{
      "brando_site_key" => @current_site && @current_site.key,
      "brando_environment_key" => @current_environment && @current_environment.key
    },
    sticky: true
  )}
  {live_render(@socket, BrandoAdmin.UploadManager, id: "brando-upload-manager-lv", sticky: true)}
  {live_render(@socket, BrandoAdmin.Nav,
    id: "brando-nav",
    session: %{
      "current_url" => @uri && @uri.path,
      "brando_site_key" => @current_site && @current_site.key,
      "brando_environment_key" => @current_environment && @current_environment.key
    },
    sticky: true
  )}
  {live_render(@socket, BrandoAdmin.CommandPaletteLive,
    id: "brando-command-palette",
    session: %{
      "brando_site_key" => @current_site && @current_site.key,
      "brando_environment_key" => @current_environment && @current_environment.key
    },
    sticky: true
  )}
  <div id="admin" phx-hook="Brando.Admin">
    <%= if @socket_connected do %>
      <%!-- Nothing to switch between on a single-language site. --%>
      <.live_component
        :if={length(Brando.config(:languages) || []) > 1}
        module={BrandoAdmin.Components.ContentLanguageSwitch}
        id="content-language-switch"
        current_user={@current_user}
      />
      <%!-- data-create-url: a listing's "new entry" page, for the `c` shortcut --%>
      <main
        id="brando-main"
        data-authorization-upload={Brando.Authorization.Media.token(@current_user)}
        data-create-url={assigns[:admin_create_url]}
      >
        <article class={["content", assigns[:admin_workspace?] && "admin-workspace content-workspace"]}>
          {@inner_content}
        </article>
        <%!-- A sensitive action held until the user confirms it is them, see BrandoAdmin.Reauth --%>
        <BrandoAdmin.Reauth.prompt :if={match?(%{event: _}, assigns[:reauth])} reauth={@reauth} />
      </main>
    <% else %>
      <%!-- An entry editor's first render, before LiveView connects --%>
      <main :if={assigns[:entry_skeleton]} id="brando-main">
        <article class="content">
          <BrandoAdmin.Components.Form.EntrySkeleton.form id="entry-skeleton" skeleton={@entry_skeleton} />
        </article>
      </main>
    <% end %>
  </div>
<% else %>
  <div id="admin">
    {@inner_content}
  </div>
<% end %>
