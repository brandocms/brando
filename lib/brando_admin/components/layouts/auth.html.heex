<!DOCTYPE html>
<html lang="en">
  <head>
    <.csrf_meta_tag />
    <.live_title>{assigns[:page_title] || "Brando"}</.live_title>
    <script>
      (function(C){C.remove('no-js');C.add('js');C.add('moonwalk')})(document.documentElement.classList)
    </script>
    <%!-- The login reveal is hidden by a RULE, not by an inline style: the login
          screen is a LiveView, and the connected mount patches #application-login
          back to server truth — which would delete any style attribute JS had put
          there, flashing the un-animated form. `login-revealed` lands on <html>,
          which LiveView never touches, and is added the moment the reveal starts
          so a later patch can never strand the form invisible.

          The @layer statement fixes the order of the admin's cascade layers
          before any stylesheet loads: the icon sheet (reset), third-party
          styles, Brando's rules, then the application's. --%>
    <style>
      @layer reset,vendor,brando,app;html.moonwalk [data-moonwalk-run],html.moonwalk [data-moonwalk-section],html.moonwalk [data-moonwalk]{opacity:0}html.moonwalk:not(.login-revealed) #application-login{opacity:0}html.moonwalk:not(.app-revealed) :is(#navigation,#admin,#brando-chrome){opacity:0}.fader{background-color:var(--brando-surface-page,#fafbf9);position:fixed;top:0;left:0;right:0;bottom:0;z-index:9998;display:none}
    </style>
    <link rel="stylesheet" href={Brando.Icons.stylesheet_path()} />
    <.include_assets admin />
  </head>
  <body
    id="app"
    data-env={Brando.env()}
    data-real-motion={Application.get_env(:brando, :e2e_real_motion, false) && "true"}
    class="auth-login"
  >
    <div class="fader" id="fader">
      <script>
        var zf = document.getElementById("fader");zf.style.display = 'block';window.bfTO = setTimeout(function(){zf.style.display = 'none';document.documentElement.classList.add('app-revealed','login-revealed')},5000);
      </script>
      <div class="loading-container"></div>
    </div>
    {@inner_content}
  </body>
</html>
