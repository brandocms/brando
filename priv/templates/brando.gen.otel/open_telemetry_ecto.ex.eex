defmodule <%= inspect application_module %>.O11y.OpenTelemetryEcto do
  @moduledoc """
  A wrapper around OpenTelemetryEcto that leaves out Oban's own queries and
  queries no recording span is waiting for.
  """

  def setup(event_prefix, config \\ []) do
    event = event_prefix ++ [:query]
    :telemetry.attach({__MODULE__, event}, event, &__MODULE__.handle_event/4, config)
  end

  @doc false
  # OpentelemetryEcto copies the whole process dictionary on every query to find
  # the parent span, before the sampler decides, and a process rendering a page
  # holds a large one. So a query is passed on only when its span would be
  # recorded under a parent: one in this process, or in the process that
  # started this task.
  def handle_event(event, measure, meta, config) do
    if traced?(meta), do: OpentelemetryEcto.handle_event(event, measure, meta, config), else: :ok
  end

  defp traced?(meta) do
    not Keyword.has_key?(Map.get(meta, :options, []), :oban_conf) and
      (recording?(OpenTelemetry.Ctx.get_current()) or caller_recording?())
  end

  defp recording?(ctx),
    do: ctx |> OpenTelemetry.Tracer.current_span_ctx() |> OpenTelemetry.Span.is_recording()

  # Reads the one key OpenTelemetry keeps its context under. Before OTP 26.2
  # `Process.info/2` cannot read a single key, so the query is passed on.
  defp caller_recording? do
    with [caller | _] when is_pid(caller) <- Process.get(:"$callers"),
         {{:dictionary, _}, %{} = ctx} <-
           Process.info(caller, {:dictionary, :"$__current_otel_ctx"}) do
      recording?(ctx)
    else
      _ -> false
    end
  rescue
    ArgumentError -> true
  end
end
