// The site's EuropaCSS theme, compiled by the native `europa` executable
// through @brandocms/vite-plugin-europacss (see vite.config.js). It holds the
// tokens the installed CSS reads; europa.example.json5 beside it is a fuller
// worked set to copy from. JSON5: comments, trailing commas, and
// `'{colors.bone.full}'` to refer to another token. Vite reloads the CSS when
// this file changes.
{
  // Freezes `vw` and `dpx` values at the largest breakpoint; keep it unless the site should grow past `container.maxWidth`.
  setMaxForVw: true,

  // The design's desktop artboard width, which `dpx` is relative to: set it to your Figma frame width first.
  dpxViewportSize: 1440,

  theme: {
    // Viewport ranges, each from its width to the next; js/config/BREAKPOINTS.js lists the same names, so rename both together.
    breakpoints: {
      iphone: '0',
      mobile: '480px',
      ipad_portrait: '768px',
      ipad_landscape: '1024px',
      desktop_md: '1280px',
      desktop_lg: '1440px',
      desktop_xl: '1920px',
    },

    // Named groups of breakpoints for token maps and queries (`$sm`); adjust them after changing `breakpoints`.
    breakpointCollections: {
      $mobile: '<=mobile',
      $tablet: 'ipad_portrait/ipad_landscape',
      $desktop: '>=desktop_md',
      $lg: '>=ipad_landscape',
      $sm: '<=ipad_portrait',
    },

    // Page width and side padding for `@space container`; set the padding to the design's page margin first.
    container: {
      maxWidth: { '*': '100%', desktop_xl: '1920px' },
      padding: { $mobile: '16px', '*': 'scale-from(20, desktop_lg)' },
    },

    // The column grid for `@column`, `@grid` and gutter multiples; match the design's column count and gutter first.
    columns: {
      count: { '*': 12 },
      gutters: { $mobile: '16px', '*': 'scale-from(20, desktop_lg)' },
    },

    // The palette the default modules use (dark green page, bone text, one accent); replace `green`, `bone` and `accent` with the brand's first.
    colors: {
      transparent: 'transparent',
      white: '#ffffff',
      black: '#000000',
      green: '#030e0a',
      shell: '#06150f',
      accent: '#d9b87a',
      live: '#6fcf97',

      bone: {
        full: '#ece5d8',
        muted: 'rgb(236 229 216 / 70%)',
        dim: 'rgb(236 229 216 / 50%)',
        faint: 'rgb(236 229 216 / 34%)',
        hairStrong: 'rgb(236 229 216 / 26%)',
        hair: 'rgb(236 229 216 / 14%)',
        wash: 'rgb(236 229 216 / 5%)',
      },

      // The column overlay `@europa base` draws for `.dbg-grid`.
      grid: 'rgb(111 207 151 / 20%)',

      body: {
        foreground: '{colors.bone.full}',
        background: '{colors.green}',
      },

      link: {
        regular: {
          text: '{colors.bone.full}',
          border: '{colors.bone.hairStrong}',
        },
        hover: {
          text: '{colors.accent}',
        },
      },
    },

    typography: {
      // The px value of 1rem on the html element.
      base: '16px',

      // Line height for inline sizes such as `@fontsize 15px`; named sizes carry their own.
      lineHeight: { '*': 1.5 },

      // The type scale the default modules use, px below `desktop_lg` and scaling from it; set the sizes to the design's text styles first.
      sizes: {
        'base': {
          __base__: { 'line-height': '150%' },
          '*': { 'font-size': 'scale-from(16, desktop_lg)' },
        },

        'text/xs': {
          __base__: { 'line-height': '150%' },
          '*': { 'font-size': 'scale-from(12, desktop_lg)' },
        },

        'text/sm': {
          __base__: { 'line-height': '1.42858em' },
          '*': { 'font-size': 'scale-from(14, desktop_lg)' },
        },

        'text/lg': {
          __base__: { 'line-height': '1.44445em' },
          '*': { 'font-size': 'scale-from(18, desktop_lg)' },
        },

        'code/sm': {
          __base__: { 'line-height': '1.95em' },
          $mobile: { 'font-size': '12px' },
          '*': { 'font-size': 'scale-from(13, desktop_lg)' },
        },

        'heading/xl': {
          __base__: { 'line-height': '140%' },
          '*': { 'font-size': 'scale-from(20, desktop_lg)' },
        },

        'heading/2xl': {
          __base__: { 'line-height': '1.33334em' },
          '*': { 'font-size': 'scale-from(24, desktop_lg)' },
        },

        'heading/3xl': {
          __base__: { 'line-height': '1.26667em' },
          '*': { 'font-size': 'scale-from(30, desktop_lg)' },
        },

        'heading/5xl': {
          __base__: { 'line-height': '1.16667em' },
          '*': { 'font-size': 'scale-from(48, desktop_lg)' },
        },

        'heading/7xl': {
          __base__: { 'line-height': '1em' },
          iphone: { 'font-size': '44px' },
          mobile: { 'font-size': '48px' },
          ipad_portrait: { 'font-size': '56px' },
          ipad_landscape: { 'font-size': '72px' },
          desktop_md: { 'font-size': '80px' },
          '*': { 'font-size': '92dpx' },
        },
      },

      // Font stacks for `@font`; `@europa base` needs `main` (the body) and `mono`, so put the site's typeface in `main` first.
      families: {
        main: [
          '-apple-system',
          'BlinkMacSystemFont',
          '"Segoe UI"',
          'Roboto',
          '"Helvetica Neue"',
          'Arial',
          'sans-serif',
        ],

        mono: ['Menlo', 'Monaco', 'Consolas', '"Liberation Mono"', '"Courier New"', 'monospace'],
      },
    },

    // Spacing steps for `@space` (`blocks` is the gap between blocks, `indent` the text column's inset); set `blocks` and the steps to the design's rhythm first.
    spacing: {
      xxs: { '*': 'scale-from(8, desktop_lg)' },
      xs: { '*': 'scale-from(10, desktop_lg)' },
      sm: { '*': 'scale-from(16, desktop_lg)' },
      md: { '*': 'scale-from(24, desktop_lg)' },
      lg: { '*': 'scale-from(40, desktop_lg)' },
      xl: { $mobile: '48px', ipad_portrait: '64px', '*': 'scale-from(80, desktop_lg)' },
      xxl: { '*': 'scale-from(128, desktop_lg)' },
      blocks: { $sm: '128px', '*': 'scale-from(160, desktop_lg)' },
      indent: { $sm: '0px', '*': 'scale-from(48, desktop_lg)' },

      radius: {
        regular: { '*': 'scale-from(4, desktop_lg)' },
      },
    },
  },
}
