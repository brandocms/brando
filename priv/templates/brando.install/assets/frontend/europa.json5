// EuropaCSS configuration for the site, compiled by the native `europa`
// executable through @brandocms/vite-plugin-europacss (see vite.config.js).
// It is data, not JavaScript: JSON5 with comments and trailing commas, and
// `'{colors.bone.full}'` to refer to another token. CSS reads a value with
// `theme(colors.accent)`; breakpoint maps go through `@space`, `@fontsize`
// and the other at-rules. Vite reloads the CSS when this file changes.
{
  setMaxForVw: true,

  /* The width of the design's desktop artboard. Every `dpx` value is relative
     to it: `20dpx` is 20 pixels when the viewport matches this width, and
     scales with the viewport below it. Set it to your Figma frame width. */
  dpxViewportSize: 1440,

  theme: {
    breakpoints: {
      iphone: '0',
      mobile: '480px',
      ipad_portrait: '768px',
      ipad_landscape: '1024px',
      desktop_md: '1280px',
      desktop_lg: '1440px',
      desktop_xl: '1920px',
    },

    breakpointCollections: {
      $mobile: '<=mobile',
      $tablet: 'ipad_portrait/ipad_landscape',
      $desktop: '>=desktop_md',
      $lg: '>=ipad_landscape',
      $sm: '<=ipad_portrait'
    },

    /* A token map takes breakpoint names, collection keys from
       `breakpointCollections`, and `'*'` for the breakpoints left over. A
       named breakpoint beats a collection, and two collections that share a
       breakpoint are an error.

       `scale-from(20, desktop_lg)` is 20px below `desktop_lg` and 20dpx from
       it, so the design scales with the viewport on large screens only. A
       plain `px` value stays fixed and a plain `dpx` value scales at every
       breakpoint it covers. */
    container: {
      /* With `setMaxForVw` the largest breakpoint's maxWidth cannot be a
         percentage — EuropaCSS needs a length to freeze `vw` values against. */
      maxWidth: { '*': '100%', desktop_xl: '1920px' },
      padding: { $mobile: '16px', '*': 'scale-from(20, desktop_lg)' },
    },

    columns: {
      count: { '*': 12 },
      gutters: { $mobile: '16px', '*': 'scale-from(20, desktop_lg)' },
    },

    colors: {
      transparent: 'transparent',
      white: '#ffffff',
      black: '#000000',

      /* The page is one flat, very dark green — roughly 4% lightness at hue
         160. Everything on top of it is bone at a handful of opacities, plus
         a single champagne accent for anything interactive or indexed. */
      green: '#030e0a',

      /* One step up from the page, for insets like the terminal block. */
      shell: '#06150f',

      accent: '#d9b87a',

      /* Reserved for "this is running / this is safe" signals. */
      live: '#6fcf97',

      bone: {
        full: '#ece5d8',
        muted: 'rgb(236 229 216 / 70%)',
        dim: 'rgb(236 229 216 / 50%)',
        faint: 'rgb(236 229 216 / 34%)',
        hairStrong: 'rgb(236 229 216 / 26%)',
        hair: 'rgb(236 229 216 / 14%)',
        wash: 'rgb(236 229 216 / 5%)'
      },

      /* Debug helpers: `dbg` for ad-hoc highlighting, `grid` for the column
         overlay EuropaCSS draws. */
      dbg: 'pink',
      grid: 'rgb(111 207 151 / 20%)',

      body: {
        foreground: '#ece5d8',
        background: '#030e0a'
      },

      link: {
        regular: {
          text: '#ece5d8',
          border: 'rgb(236 229 216 / 26%)'
        },
        hover: {
          text: '#d9b87a',
          border: '#d9b87a'
        }
      }
    },

    typography: {
      /* `base` is the px value of 1rem set as font-size on the html element. */
      base: '16px',

      /* Fallback line height for inline sizes such as `@fontsize 15px`. Named
         sizes carry their own through `__base__`. */
      lineHeight: { '*': 1.5 },

      /* Sizes are flat pixels below `desktop_lg` and scale from it (see
         `scale-from()` above `container`).

         Line heights are written as `em`, not `%`: browsers floor a percentage
         line height to a whole percent, so `116.667%` lays out as `116%` and
         every fractional pair comes up short. */
      sizes: {
        'base': {
          __base__: { 'line-height': '150%' },
          '*': { 'font-size': 'scale-from(16, desktop_lg)' },
        },

        'text/xs': {
          __base__: { 'line-height': '150%' },
          '*': { 'font-size': 'scale-from(12, desktop_lg)' },
        },

        'text/sm': {
          __base__: { 'line-height': '1.42858em' },
          '*': { 'font-size': 'scale-from(14, desktop_lg)' },
        },

        'text/base': {
          __base__: { 'line-height': '150%' },
          '*': { 'font-size': 'scale-from(16, desktop_lg)' },
        },

        'text/lg': {
          __base__: { 'line-height': '1.44445em' },
          '*': { 'font-size': 'scale-from(18, desktop_lg)' },
        },

        'code/sm': {
          __base__: { 'line-height': '1.95em' },
          $mobile: { 'font-size': '12px' },
          '*': { 'font-size': 'scale-from(13, desktop_lg)' },
        },

        'heading/xl': {
          __base__: { 'line-height': '140%' },
          '*': { 'font-size': 'scale-from(20, desktop_lg)' },
        },

        'heading/2xl': {
          __base__: { 'line-height': '1.33334em' },
          '*': { 'font-size': 'scale-from(24, desktop_lg)' },
        },

        'heading/3xl': {
          __base__: { 'line-height': '1.26667em' },
          '*': { 'font-size': 'scale-from(30, desktop_lg)' },
        },

        'heading/4xl': {
          __base__: { 'line-height': '1.33334em' },
          '*': { 'font-size': 'scale-from(36, desktop_lg)' },
        },

        'heading/5xl': {
          __base__: { 'line-height': '1.16667em' },
          '*': { 'font-size': 'scale-from(48, desktop_lg)' },
        },

        'heading/6xl': {
          __base__: { 'line-height': '1.13334em' },
          '*': { 'font-size': 'scale-from(60, desktop_lg)' },
        },

        'heading/7xl': {
          __base__: { 'line-height': '1em' },
          iphone: { 'font-size': '44px' },
          mobile: { 'font-size': '48px' },
          ipad_portrait: { 'font-size': '56px' },
          ipad_landscape: { 'font-size': '72px' },
          desktop_md: { 'font-size': '80px' },
          '*': { 'font-size': '92dpx' },
        },
      },

      families: {
        /* `main` is what `@europa base` sets on the body. */
        main: [
          '-apple-system',
          'BlinkMacSystemFont',
          '"Segoe UI"',
          'Roboto',
          '"Helvetica Neue"',
          'Arial',
          'sans-serif'
        ],

        sans: [
          '-apple-system',
          'BlinkMacSystemFont',
          '"Segoe UI"',
          'Roboto',
          '"Helvetica Neue"',
          'Arial',
          'sans-serif'
        ],

        serif: ['Georgia', 'Cambria', '"Times New Roman"', 'Times', 'serif'],

        mono: ['Menlo', 'Monaco', 'Consolas', '"Liberation Mono"', '"Courier New"', 'monospace']
      }
    },

    /* Spacing steps are flat across breakpoints: a component picks a smaller
       step on mobile rather than the step shrinking. Only the block rhythm,
       the container and the gutters change size. A step is used by name
       (`@space padding-top lg`); a group such as `radius` by its path
       (`@space border-radius radius.regular`). */
    spacing: {
      xxxs: { '*': 'scale-from(4, desktop_lg)' },
      xxs: { '*': 'scale-from(8, desktop_lg)' },
      xs: { '*': 'scale-from(10, desktop_lg)' },
      sm: { '*': 'scale-from(16, desktop_lg)' },
      md: { '*': 'scale-from(24, desktop_lg)' },
      lg: { '*': 'scale-from(40, desktop_lg)' },
      xl: { $mobile: '48px', ipad_portrait: '64px', '*': 'scale-from(80, desktop_lg)' },
      xxl: { '*': 'scale-from(128, desktop_lg)' },
      blocks: { $sm: '128px', '*': 'scale-from(160, desktop_lg)' },
      blocksInner: { $sm: '64px', '*': 'scale-from(80, desktop_lg)' },
      indent: { $sm: '0px', '*': 'scale-from(48, desktop_lg)' },

      radius: {
        regular: { '*': 'scale-from(4, desktop_lg)' },
        image: { '*': 'scale-from(8, desktop_lg)' },
      },
    },
  }
}
