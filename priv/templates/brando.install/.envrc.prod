# Runtime environment for the prod target. Florist uploads this file to the
# server as .envrc.runtime, and rel/env.sh.eex sources it when the release
# starts. It holds secrets: keep it out of version control.
#
# The names are the ones a Phoenix config/runtime.exs reads. Florist creates
# the database user from the target's database settings. The user here is
# Florist's default (the project name); set FLORIST_DB_PASSWORD_PROD to the
# password below.
export PHX_HOST="<%= host %>"
export PHX_SERVER="true"
export DATABASE_URL="postgres://<%= application_name %>:__BRANDO_DATABASE_PASSWORD__@localhost/<%= application_name %>_prod"
export SECRET_KEY_BASE="__BRANDO_SECRET_KEY_BASE__"

# Node name for a :single deployment; blue/green services set their own.
export RELEASE_NODE="${RELEASE_NODE:-<%= application_name %>_prod@127.0.0.1}"

# Systemd sets PORT for each blue/green environment. Set it here only for a
# :single deployment.
# export PORT="8055"
