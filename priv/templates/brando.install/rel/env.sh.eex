#!/bin/sh

# Florist uploads the target's .envrc.<flavor> and copies it into each release
# as .envrc.runtime. It is sourced first so that its RELEASE_NODE default only
# applies when systemd has not set one.
if [ -f "$RELEASE_ROOT/.envrc.runtime" ]; then
  . "$RELEASE_ROOT/.envrc.runtime"
fi

# Long node names (name@127.0.0.1). Florist's blue/green services set
# RELEASE_NODE per colour; keep this line's ${RELEASE_NODE:-...} form.
export RELEASE_DISTRIBUTION=name
export RELEASE_NODE=${RELEASE_NODE:-<%%= @release.name %>@127.0.0.1}
