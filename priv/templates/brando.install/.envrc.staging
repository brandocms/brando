# Runtime environment for the staging target. Florist uploads this file to the
# server as .envrc.runtime. It holds secrets: keep it out of version control.
#
# The names are the ones a Phoenix config/runtime.exs reads. The database
# password must match FLORIST_DB_PASSWORD_STAGING, which Florist uses to create
# the database user.
export PHX_HOST="<%= host %>"
export PHX_SERVER="true"
export DATABASE_URL="postgres://<%= application_name %>:<%= :crypto.strong_rand_bytes(24) |> Base.url_encode64(padding: false) %>@localhost/<%= application_name %>_staging"
export SECRET_KEY_BASE="<%= :crypto.strong_rand_bytes(64) |> Base.encode64() |> binary_part(0, 64) %>"

# Systemd sets PORT for each blue/green environment. Set it here only for a
# :single deployment.
# export PORT="8060"
