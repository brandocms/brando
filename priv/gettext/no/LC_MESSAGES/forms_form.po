msgstr "Varsel"

#: lib/brando/forms/form.ex:165
#, elixir-autogen, elixir-format
msgid "Page after sending"
msgstr "Side etter sending"

#: lib/brando/forms/form.ex:182
#, elixir-autogen, elixir-format
msgid "Put in what a visitor filled in by its field key, like {{ name }}. Leave empty for “New submission” and the form's title. Replies go to the email address the visitor filled in."
msgstr "Sett inn det en besøkende fylte inn med feltets nøkkel, som {{ name }}. La stå tomt for «Ny innsending» og skjemaets tittel. Svar går til e-postadressen den besøkende fylte inn."

#: lib/brando/forms/form.ex:186
#, elixir-autogen, elixir-format
msgid "Recipients"
msgstr "Mottakere"

#: lib/brando/forms/form.ex:202
#, elixir-autogen, elixir-format
msgid "Send a confirmation"
msgstr "Send kvittering"

#: lib/brando/forms/form.ex:212
#, elixir-autogen, elixir-format
msgid "Shown above the copy. Leave empty to use the success message."
msgstr "Vises over kopien. La stå tomt for å bruke bekreftelsesmeldingen."

