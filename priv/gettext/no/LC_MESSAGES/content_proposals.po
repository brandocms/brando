#: lib/brando/content/proposals.ex
#, elixir-autogen, elixir-format
msgid "%{content_type} #%{id}"
msgstr "%{content_type} #%{id}"

#: lib/brando/content/proposals/image_replacement.ex
#, elixir-autogen, elixir-format
msgid "%{count} entry you cannot see"
msgid_plural "%{count} entries you cannot see"
msgstr[0] "%{count} oppføring du ikke kan se"
msgstr[1] "%{count} oppføringer du ikke kan se"

#: lib/brando/content/proposals/review.ex
#, elixir-autogen, elixir-format
msgid "%{count} item"
msgid_plural "%{count} items"
msgstr[0] "%{count} element"
msgstr[1] "%{count} elementer"

#: lib/brando/content/proposals/image_replacement.ex
#, elixir-autogen, elixir-format
msgid "%{entries} and %{count} entry you cannot see"
msgid_plural "%{entries} and %{count} entries you cannot see"
msgstr[0] "%{entries} og %{count} oppføring du ikke kan se"
msgstr[1] "%{entries} og %{count} oppføringer du ikke kan se"

#: lib/brando/content/proposals.ex
#, elixir-autogen, elixir-format
msgid "%{entries} changed after the proposal was applied. Undo would overwrite that."
msgstr "%{entries} er endret etter at forslaget ble utført. Å angre ville overskrevet det."

#: lib/brando/content/proposals.ex
#, elixir-autogen, elixir-format
msgid "%{entry} became its translation group's source after the proposal was applied. Undo would leave the group without a source: make another version the source first."
msgstr "%{entry} ble kilden i oversettelsesgruppen etter at forslaget ble utført. Å angre ville latt gruppen stå uten kilde: gjør en annen versjon til kilde først."

#: lib/brando/content/proposals.ex
#, elixir-autogen, elixir-format
msgid "%{entry} became the source of synchronized translations after the proposal was applied, and one in the trash counts too. Restore it from the trash, then make it independent or make it the source, before undoing."
msgstr "%{entry} ble kilden til synkroniserte oversettelser etter at forslaget ble utført, og en oversettelse i papirkurven teller også. Gjenopprett den fra papirkurven, og gjør den så selvstendig eller til kilde, før du angrer."

#: lib/brando/content/proposals.ex
#, elixir-autogen, elixir-format
msgid "%{entry} became the source of synchronized translations after the proposal was applied. Make them independent, or make one of them the source, before undoing."
msgstr "%{entry} ble kilden til synkroniserte oversettelser etter at forslaget ble utført. Gjør dem selvstendige, eller gjør en av dem til kilde, før du angrer."

#: lib/brando/content/proposals.ex
#, elixir-autogen, elixir-format
msgid "%{field} cannot be changed by a proposal."
msgstr "%{field} kan ikke endres av et forslag."

#: lib/brando/content/proposals.ex
#, elixir-autogen, elixir-format
msgid "%{field} is text of a synchronized translation, which is translation work: write it with a translate operation, which saves it as the translation form does. A text with no open work (translation_work does not list it) is changed by the editor in the translation's form."
msgstr "%{field} er tekst i en synkronisert oversettelse, altså oversettelsesarbeid: skriv den med en translate-operasjon, som lagrer den slik oversettelsesskjemaet gjør. En tekst uten åpent arbeid (translation_work lister den ikke) endres av redaktøren i oversettelsens skjema."

#: lib/brando/content/proposals.ex
#, elixir-autogen, elixir-format
msgid "%{field} of a synchronized translation follows its source: change it in the source, and the translation follows."
msgstr "%{field} i en synkronisert oversettelse følger kilden: endre det i kilden, så følger oversettelsen etter."

#: lib/brando/content/proposals.ex
#, elixir-autogen, elixir-format
msgid "%{field} of a synchronized translation is its place in its translation group and cannot be changed."
msgstr "%{field} i en synkronisert oversettelse er dens plass i oversettelsesgruppen og kan ikke endres."

#: lib/brando/content/proposals.ex
#, elixir-autogen, elixir-format
msgid "%{key} cannot be set to this value."
msgstr "%{key} kan ikke settes til denne verdien."

#: lib/brando/content/proposals.ex
#, elixir-autogen, elixir-format
msgid "%{key} cannot link to this content type."
msgstr "%{key} kan ikke lenke til denne innholdstypen."

#: lib/brando/content/proposals.ex
#, elixir-autogen, elixir-format
msgid "%{key} has no option %{value}."
msgstr "%{key} har ikke valget %{value}."

#: lib/brando/content/proposals/codec.ex
#, elixir-autogen, elixir-format
msgid "%{key} is an image ({kind: image, id}): only an image's file can be replaced so far."
msgstr "%{key} er et bilde ({kind: image, id}): foreløpig kan bare et bildes fil erstattes."

#: lib/brando/content/proposals/codec.ex
#, elixir-autogen, elixir-format
msgid "%{key} is required."
msgstr "%{key} er påkrevd."

#: lib/brando/content/proposals/codec.ex
#, elixir-autogen, elixir-format
msgid "%{key} is text."
msgstr "%{key} er tekst."

#: lib/brando/content/proposals/codec.ex
#, elixir-autogen, elixir-format
msgid "%{key} is true or false."
msgstr "%{key} er true eller false."

#: lib/brando/content/proposals.ex
#, elixir-autogen, elixir-format
msgid "%{key} shows the text the module gives it."
msgstr "%{key} viser teksten modulen gir den."

#: lib/brando/content/proposals.ex
#, elixir-autogen, elixir-format
msgid "%{language} is not one of the site's languages for %{name} entries."
msgstr "%{language} er ikke et av nettstedets språk for %{name}-oppføringer."

#: lib/brando/content/proposals.ex
#, elixir-autogen, elixir-format
msgid "%{name} cannot hold a {, which the page could read as Liquid."
msgstr "%{name} kan ikke inneholde {, som siden kan lese som Liquid."

#: lib/brando/content/proposals.ex
#, elixir-autogen, elixir-format
msgid "%{name} contains unsafe rich text."
msgstr "%{name} inneholder utrygg rik tekst."

#: lib/brando/content/proposals.ex
#, elixir-autogen, elixir-format
msgid "%{name} does not accept this media type."
msgstr "%{name} godtar ikke denne medietypen."

#: lib/brando/content/proposals.ex
#, elixir-autogen, elixir-format
msgid "%{name} entries are not synchronized translations. Create the version in another language with create_entry instead."
msgstr "%{name}-oppføringer er ikke synkroniserte oversettelser. Opprett versjonen på et annet språk med create_entry i stedet."

#: lib/brando/content/proposals.ex
#, elixir-autogen, elixir-format
msgid "%{name} entries cannot be copied, so they cannot be translated."
msgstr "%{name}-oppføringer kan ikke kopieres, så de kan ikke oversettes."

#: lib/brando/content/proposals.ex
#, elixir-autogen, elixir-format
msgid "%{name} holds markup only a superuser changes."
msgstr "%{name} inneholder kode som bare en superbruker endrer."

#: lib/brando/content/proposals.ex
#, elixir-autogen, elixir-format
msgid "%{name} is answered more than once. Give a text in texts or list it in reviewed, not both."
msgstr "%{name} er besvart mer enn én gang. Gi en tekst i texts eller list den i reviewed, ikke begge."

#: lib/brando/content/proposals.ex
#, elixir-autogen, elixir-format
msgid "%{name} is not a unit of the batch this source_digest was read with. Leave it out."
msgstr "%{name} er ikke en del av bunken denne source_digest ble lest med. Utelat den."

#: lib/brando/content/proposals.ex
#, elixir-autogen, elixir-format
msgid "%{name} is not answered. Give its translation in texts, or list it in reviewed to keep it."
msgstr "%{name} er ikke besvart. Gi oversettelsen i texts, eller list den i reviewed for å beholde den."

#: lib/brando/content/proposals.ex
#, elixir-autogen, elixir-format
msgid "%{name} puts a template placeholder in markup the source does not have around it. Keep each placeholder where the source has it: as text inside the same tags, or in the same attribute of the same tag."
msgstr "%{name} legger en malplassholder i markering kilden ikke har rundt den. Behold hver plassholder der kilden har den: som tekst inne i de samme taggene, eller i det samme attributtet på den samme taggen."

#: lib/brando/content/proposals.ex
#, elixir-autogen, elixir-format
msgid "%{name} takes a web, mail or phone address."
msgstr "%{name} tar en nett-, e-post- eller telefonadresse."

#: lib/brando/content/proposals.ex
#, elixir-autogen, elixir-format
msgid "%{name} takes an https Google Maps embed address."
msgstr "%{name} tar en https-adresse for innebygging fra Google Maps."

#: lib/brando/content/proposals.ex
#, elixir-autogen, elixir-format
msgid "%{name} takes no quotes or markup."
msgstr "%{name} tar ikke anførselstegn eller markering."

#: lib/brando/content/proposals.ex
#, elixir-autogen, elixir-format
msgid "%{name} takes plain text."
msgstr "%{name} tar ren tekst."

#: lib/brando/content/proposals/review.ex
#, elixir-autogen, elixir-format
msgid "%{position} of %{count} in “%{parent}”"
msgstr "%{position} av %{count} i “%{parent}”"

#: lib/brando/content/proposals.ex
#, elixir-autogen, elixir-format
msgid "A block cannot move inside itself."
msgstr "En blokk kan ikke flyttes inn i seg selv."

#: lib/brando/content/proposals.ex
#, elixir-autogen, elixir-format
msgid "A block description is at most 255 characters."
msgstr "En blokkbeskrivelse kan være på høyst 255 tegn."

#: lib/brando/content/proposals/codec.ex
#, elixir-autogen, elixir-format
msgid "A gallery holds images and videos."
msgstr "Et galleri inneholder bilder og videoer."

#: lib/brando/content/proposals/codec.ex
#, elixir-autogen, elixir-format
msgid "A link points to a URL or an entry {\"content_type\": T, \"id\": N}."
msgstr "En lenke peker til en URL eller en oppføring {\"content_type\": T, \"id\": N}."

#: lib/brando/content/proposals.ex
#, elixir-autogen, elixir-format
msgid "A link points to an entry that was not found or has no page yet."
msgstr "En lenke peker til en oppføring som ikke finnes eller ikke har noen side ennå."

#: lib/brando/content/proposals/codec.ex
#, elixir-autogen, elixir-format
msgid "A link's text is a string."
msgstr "Teksten til en lenke er en streng."

#: lib/brando/content/proposals.ex
#, elixir-autogen, elixir-format
msgid "A module changed after this proposal was prepared. Review it again."
msgstr "En modul er endret etter at forslaget ble laget. Se gjennom det på nytt."

#: lib/brando/content/proposals.ex
#, elixir-autogen, elixir-format
msgid "A newer version of this proposal exists. Review it instead."
msgstr "Det finnes en nyere versjon av forslaget. Se gjennom den i stedet."

#: lib/brando/content/proposals.ex
#, elixir-autogen, elixir-format
msgid "A proposal cannot change %{name}."
msgstr "Et forslag kan ikke endre %{name}."

#: lib/brando/content/proposals/codec.ex
#, elixir-autogen, elixir-format
msgid "A proposal cannot create or change %{name} entries. It can only change the content types list_content_types lists."
msgstr "Et forslag kan ikke opprette eller endre oppføringer av typen %{name}. Det kan bare endre innholdstypene som list_content_types viser."

#: lib/brando/content/proposals.ex
#, elixir-autogen, elixir-format
msgid "A proposal requires an authenticated user."
msgstr "Et forslag krever en innlogget bruker."

#: lib/brando/content/proposals/codec.ex
#, elixir-autogen, elixir-format
msgid "A ref is at most %{max} characters."
msgstr "En ref er på høyst %{max} tegn."

#: lib/brando/content/proposals.ex
#, elixir-autogen, elixir-format
msgid "A slot cannot be moved or deleted."
msgstr "En plass kan ikke flyttes eller slettes."

#: lib/brando/content/proposals/codec.ex
#, elixir-autogen, elixir-format
msgid "A target is {content_type, id} or {new: ref}."
msgstr "Et mål er {content_type, id} eller {new: ref}."

#: lib/brando/content/proposals/codec.ex
#, elixir-autogen, elixir-format
msgid "A target needs a numeric id."
msgstr "Et mål trenger en numerisk id."

#: lib/brando/content/proposals.ex
#, elixir-autogen, elixir-format
msgid "A translate operation in this proposal fills in this translation, and it can be the only kind of operation on it: its structure follows its source, and its text is saved as its translation form saves it. Put this change in another proposal, or the text in the translate operation."
msgstr "En translate-operasjon i dette forslaget fyller ut denne oversettelsen, og den kan være den eneste typen operasjon på den: strukturen følger kilden, og teksten lagres slik oversettelsesskjemaet lagrer den. Legg denne endringen i et annet forslag, eller teksten i translate-operasjonen."

#: lib/brando/content/proposals.ex
#, elixir-autogen, elixir-format
msgid "A uid can be at most %{count} characters long."
msgstr "En uid kan ha høyst %{count} tegn."

#: lib/brando/content/proposals.ex
#, elixir-autogen, elixir-format
msgid "A uid can only hold letters, digits, - and _, and cannot end with -."
msgstr "En uid kan bare inneholde bokstaver, sifre, - og _, og kan ikke slutte med -."

#: lib/brando/content/proposals/review.ex
#, elixir-autogen, elixir-format
msgid "After %{block}"
msgstr "Etter %{block}"

#: lib/brando/content/proposals/image_replacement.ex
#, elixir-autogen, elixir-format
msgid "An SVG can only be replaced with an SVG."
msgstr "En SVG kan bare erstattes med en SVG."

#: lib/brando/content/proposals/image_replacement.ex
#, elixir-autogen, elixir-format
msgid "An SVG can only replace an SVG."
msgstr "En SVG kan bare erstatte en SVG."

#: lib/brando/content/proposals.ex
#, elixir-autogen, elixir-format
msgid "An anchor starts with a letter and holds letters, digits, - and _."
msgstr "Et anker starter med en bokstav og inneholder bokstaver, sifre, - og _."

#: lib/brando/content/proposals.ex
#, elixir-autogen, elixir-format
msgid "An earlier operation in this proposal already creates this version."
msgstr "En tidligere operasjon i dette forslaget oppretter allerede denne versjonen."

#: lib/brando/content/proposals.ex
#, elixir-autogen, elixir-format
msgid "An earlier translate operation in this proposal already answers %{name}."
msgstr "En tidligere oversettelsesoperasjon i dette forslaget besvarer allerede %{name}."

#: lib/brando/content/proposals.ex
#, elixir-autogen, elixir-format
msgid "An entry has no earlier revision to go back to."
msgstr "En oppføring har ingen tidligere revisjon å gå tilbake til."

#: lib/brando/content/proposals.ex
#, elixir-autogen, elixir-format
msgid "An entry in this proposal has become a synchronized translation since it was approved. Prepare the proposal again."
msgstr "En oppføring i dette forslaget har blitt en synkronisert oversettelse siden det ble godkjent. Lag forslaget på nytt."

#: lib/brando/content/proposals/image_replacement.ex
#, elixir-autogen, elixir-format
msgid "An image cannot be replaced with itself."
msgstr "Et bilde kan ikke erstattes med seg selv."

#: lib/brando/content/proposals.ex
#, elixir-autogen, elixir-format
msgid "Approve this version of the proposal before applying it."
msgstr "Godkjenn denne versjonen av forslaget før du utfører det."

#: lib/brando/content/proposals/review.ex
#, elixir-autogen, elixir-format
msgid "At the end"
msgstr "Til slutt"

#: lib/brando/content/proposals/review.ex
#, elixir-autogen, elixir-format
msgid "At the end of %{block}"
msgstr "Sist i %{block}"

#: lib/brando/content/proposals/review.ex
#, elixir-autogen, elixir-format
msgid "Before %{block}"
msgstr "Før %{block}"

#: lib/brando/content/proposals/review.ex
#, elixir-autogen, elixir-format
msgid "Block"
msgstr "Blokk"

#: lib/brando/content/proposals.ex
#, elixir-autogen, elixir-format
msgid "Choose entries from the block's options (list_selection_options)."
msgstr "Velg oppføringer blant blokkens valg (list_selection_options)."

#: lib/brando/content/proposals.ex
#, elixir-autogen, elixir-format
msgid "Content changed after this proposal was prepared. Review it again."
msgstr "Innholdet er endret etter at forslaget ble laget. Se gjennom det på nytt."

#: lib/brando/content/proposals/image_replacement.ex
#, elixir-autogen, elixir-format
msgid "Could not queue the image's sizes: %{error}"
msgstr "Kunne ikke sette bildets størrelser i kø: %{error}"

#: lib/brando/content/proposals.ex
#, elixir-autogen, elixir-format
msgid "Creating a translation takes permission to edit %{name} entries as well, which you do not have."
msgstr "Å opprette en oversettelse krever også tillatelse til å redigere %{name}-oppføringer, og den har du ikke."

#: lib/brando/content/proposals/review.ex
#, elixir-autogen, elixir-format
msgid "Deactivated"
msgstr "Deaktivert"

#: lib/brando/content/proposals/review.ex
#, elixir-autogen, elixir-format
msgid "Draft"
msgstr "Utkast"

#: lib/brando/content/proposals/codec.ex
#, elixir-autogen, elixir-format
msgid "Each operation needs an \"op\"."
msgstr "Hver operasjon trenger en «op»."

#: lib/brando/content/proposals.ex
#, elixir-autogen, elixir-format
msgid "Entry validation: %{errors}"
msgstr "Validering av oppføringen: %{errors}"

#: lib/brando/content/proposals/codec.ex
#, elixir-autogen, elixir-format
msgid "Expected a numeric id."
msgstr "Forventet en numerisk id."

#: lib/brando/content/proposals/codec.ex
#, elixir-autogen, elixir-format
msgid "Expected an object."
msgstr "Forventet et objekt."

#: lib/brando/content/proposals/review.ex
#, elixir-autogen, elixir-format
msgid "File #%{id}"
msgstr "Fil #%{id}"

#: lib/brando/content/proposals/image_replacement.ex
#, elixir-autogen, elixir-format
msgid "Image %{id} has another file than when this proposal was prepared. Prepare it again."
msgstr "Bilde %{id} har en annen fil enn da forslaget ble laget. Lag det på nytt."

#: lib/brando/content/proposals/image_replacement.ex
#, elixir-autogen, elixir-format
msgid "Image %{id} is already used, and its record goes when its file replaces another image's. Swap the references to it instead (set_block_media, set_fields), or upload the file again as a new image."
msgstr "Bilde %{id} er allerede i bruk, og oppføringen fjernes når filen erstatter et annet bildes fil. Bytt heller referansene til det (set_block_media, set_fields), eller last opp filen på nytt som et nytt bilde."

#: lib/brando/content/proposals/image_replacement.ex
#, elixir-autogen, elixir-format
msgid "Image %{id} is in the trash."
msgstr "Bilde %{id} ligger i papirkurven."

#: lib/brando/content/proposals/image_replacement.ex
#, elixir-autogen, elixir-format
msgid "Image %{id} is replaced in another operation of this proposal too."
msgstr "Bilde %{id} erstattes også i en annen operasjon i dette forslaget."

#: lib/brando/content/proposals/image_replacement.ex
#, elixir-autogen, elixir-format
msgid "Image %{id} is used in another replacement of this proposal too."
msgstr "Bilde %{id} brukes også i en annen erstatning i dette forslaget."

#: lib/brando/content/proposals/image_replacement.ex
#, elixir-autogen, elixir-format
msgid "Image %{new} is the same file as image %{old}."
msgstr "Bilde %{new} er samme fil som bilde %{old}."

#: lib/brando/content/proposals/image_replacement.ex
#, elixir-autogen, elixir-format
msgid "Image %{new}'s file is delivered through another CDN than image %{old}'s field uses, so image %{old} would not find it. Upload the file again to image %{old}'s field."
msgstr "Filen til bilde %{new} leveres gjennom et annet CDN enn feltet til bilde %{old} bruker, så bilde %{old} ville ikke funnet den. Last opp filen på nytt i feltet til bilde %{old}."

#: lib/brando/content/proposals/image_replacement.ex
#, elixir-autogen, elixir-format
msgid "Image %{old}'s field takes %{types}; the file of image %{new} is %{type}."
msgstr "Feltet til bilde %{old} tar %{types}; filen til bilde %{new} er %{type}."

#: lib/brando/content/proposals/auto_apply.ex
#, elixir-autogen, elixir-format
msgid "It was not applied automatically: %{reason} It waits for review."
msgstr "Det ble ikke tatt i bruk automatisk: %{reason} Det venter på gjennomgang."

#: lib/brando/content/proposals/auto_apply.ex
#, elixir-autogen, elixir-format
msgid "It was not applied automatically: a translation it creates would not be an unpublished draft. It waits for review."
msgstr "Det ble ikke tatt i bruk automatisk: en oversettelse det oppretter ville ikke blitt et upublisert utkast. Det venter på gjennomgang."

#: lib/brando/content/proposals/auto_apply.ex
#, elixir-autogen, elixir-format
msgid "It was not applied automatically: applying it failed. It waits for review."
msgstr "Det ble ikke tatt i bruk automatisk: det feilet. Det venter på gjennomgang."

#: lib/brando/content/proposals/auto_apply.ex
#, elixir-autogen, elixir-format
msgid "It was not applied automatically: fix its problems first. It waits for review."
msgstr "Det ble ikke tatt i bruk automatisk: rett problemene først. Det venter på gjennomgang."

#: lib/brando/content/proposals/auto_apply.ex
#, elixir-autogen, elixir-format
msgid "It was not applied automatically: meanwhile it became %{status}. Call list_proposals to see where it stands."
msgstr "Det ble ikke tatt i bruk automatisk: i mellomtiden fikk det status %{status}. Kall list_proposals for å se hvor det står."

#: lib/brando/content/proposals/auto_apply.ex
#, elixir-autogen, elixir-format
msgid "It was not applied automatically: only a connected tool, on a connection that is still allowed to, can apply without review. It waits for review."
msgstr "Det ble ikke tatt i bruk automatisk: bare et tilkoblet verktøy, på en tilkobling som fortsatt har lov, kan ta i bruk uten gjennomgang. Det venter på gjennomgang."

#: lib/brando/content/proposals/auto_apply.ex
#, elixir-autogen, elixir-format
msgid "It was not applied automatically: only a proposal whose every operation is create_translation, or translate of a translation it creates ({\"new\": ref}), is. It waits for review."
msgstr "Det ble ikke tatt i bruk automatisk: bare et forslag der hver operasjon er create_translation, eller translate av en oversettelse det oppretter ({\"new\": ref}), blir det. Det venter på gjennomgang."

#: lib/brando/content/proposals/auto_apply.ex
#, elixir-autogen, elixir-format
msgid "It was not applied automatically: the person may not review proposals (Assistant → Use). It waits for review."
msgstr "Det ble ikke tatt i bruk automatisk: personen kan ikke gå gjennom forslag (Assistent → Bruke). Det venter på gjennomgang."

#: lib/brando/content/proposals/auto_apply.ex
#, elixir-autogen, elixir-format
msgid "It was not applied automatically: this connection is not set to apply unpublished translations without review. It waits for review; a site manager can change that under Configuration → Integrations → Connected AI tools."
msgstr "Det ble ikke tatt i bruk automatisk: denne tilkoblingen er ikke satt til å ta i bruk upubliserte oversettelser uten gjennomgang. Det venter på gjennomgang; en som administrerer nettstedet kan endre det under Konfigurasjon → Integrasjoner → Tilkoblede AI-verktøy."

#: lib/brando/content/proposals.ex
#, elixir-autogen, elixir-format
msgid "Markdown"
msgstr "Markdown"

#: lib/brando/content/proposals/codec.ex
#, elixir-autogen, elixir-format
msgid "Media is {kind: image|video|file, id}, an attachment alias or {gallery: [media]}."
msgstr "Media er {kind: image|video|file, id}, et vedleggsalias eller {gallery: [media]}."

#: lib/brando/content/proposals/codec.ex
#, elixir-autogen, elixir-format
msgid "No attachment is called %{alias}."
msgstr "Ingen vedlegg heter %{alias}."

#: lib/brando/content/proposals.ex
