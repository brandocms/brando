msgid "You do not have permission to save this entry."
msgstr "Du har ikke tilgang til å lagre denne oppføringen."

#: lib/brando/content/proposals/image_replacement.ex
#, elixir-autogen, elixir-format
msgid "You may not change image %{ids}."
msgid_plural "You may not change images %{ids}."
msgstr[0] "Du har ikke lov til å endre bilde %{ids}."
msgstr[1] "Du har ikke lov til å endre bildene %{ids}."

#: lib/brando/content/proposals/preview.ex
#, elixir-autogen, elixir-format
msgid "You may not edit this entry as the proposal leaves it."
msgstr "Du har ikke lov til å redigere denne oppføringen slik forslaget etterlater den."

#: lib/brando/content/proposals/image_replacement.ex
#, elixir-autogen, elixir-format
msgid "You may not see the images this proposal replaces."
msgstr "Du har ikke lov til å se bildene dette forslaget erstatter."

