{
  /* Nested rules under a selector list become explicit lists, each branch
     with its own specificity, as the legacy compiler wrote them, rather than
     `:is()`. Applications that extend this preset inherit it. */
  nesting: 'expanded',

  /* Hand-written `@media` stays where it is written; only media generated by
     Europa directives (`@space`, `@fontsize`, `@responsive`…) follows the
     plain rules of its scope, as the legacy compiler ordered them. */
  responsiveOrder: 'generated-last',

  /* Migration analysis only: the 0.13 build did not pack or sort media
     queries (checked against its compiled order), so warnings that depend
     on packing don't apply. Emitted CSS is unchanged. */
  migration: {
    mediaPacking: 'none',
  },

  theme: {
    breakpoints: {
      iphone: '0',
      mobile: '480px',
      ipad_portrait: '768px',
      ipad_landscape: '1024px',
      desktop_md: '1200px',
      desktop_lg: '1440px',
      desktop_xl: '1920px',
    },

    breakpointCollections: {
      $mobile: '<=mobile',
      $tablet: 'ipad_portrait/ipad_landscape',
      $desktop: '>=desktop_md',
      $lg: '>=ipad_landscape',
      $sm: '<=ipad_portrait',
    },

    /* The admin palette. css/tokens.css sets the colour roles Brando's
       stylesheets use from these values, so an application changes the
       admin's colours here, in its own europa.json5:

         dark          --brando-ink               text
         blue          --brando-accent            the action colour
         peachLighter  --brando-surface-page      the page behind the panels
         peach         --brando-surface-subform   subforms and quiet panels
         peachDarker   --brando-surface-selected  selected items, drop targets
         peachDarkest  --brando-line              hairlines and borders
         overlay       --brando-overlay           modal and loader backdrop
         status.*      --brando-status-*          entry status dots

       Every other colour role in tokens.css has an entry below the status
       colours, so all of the admin's colours are set here. Application CSS
       can also use these names with `theme(colors.*)` and `@color`; values
       that repeat another entry refer to it, so they follow an override. */
    colors: {
      dark: '#272b2a',
      grayLight: '#BCBCBC',
      white: '#ffffff',
      black: '#000000',
      input: '#f6f6f6',
      peach: '#f8fbf6',
      peachLighter: '#fafbf9',
      peachDarker: '#eef3ea',
      peachDarkest: '#dce2dc',
      blue: '#254e3f',
      overlay: 'rgb(30 43 37 / 30%)',
      gray: '#333333',
      transparent: 'transparent',

      status: {
        draft: '#636363',
        pending: '#f1ac00',
        published: '#3cb371',
        disabled: '#cd5c5c',
        deleted: '#171a18',
      },

      /* The other colour roles in css/tokens.css, by the custom property
         they set: muted is --brando-muted, line.strong --brando-line-strong,
         attention.tint --brando-attention, module.pink.dot
         --brando-module-pink-dot, presence.p0 --brando-presence-0. */
      muted: '#626b66',
      inkInverse: '{colors.white}',
      faint: '#9aa39c',
      line: {
        strong: '#bacabd',
        soft: '#ecf0ea',
        subform: '#e2e9df',
        input: '#e0e0e0',
      },
      accentHover: '#1a3d30',
      surface: {
        base: '{colors.white}',
        shaded: '#fbfcfa',
        hover: '#f5f8f3',
        tint: '#f1f5ef',
      },
      badge: {
        fill: '#eef0eb',
        ink: '#566153',
      },
      ai: '#634f8f',
      attention: {
        tint: '#fbefda',
        line: '#e4b866',
        ink: '#87662d',
      },
      success: {
        tint: '#e8f2e9',
        line: '#d0e3d2',
        ink: '#2f6343',
      },
      error: {
        tint: '#fff1ed',
        line: '#e8ccc4',
        ink: '#8c4232',
      },
      module: {
        pink: {
          line: '#fce7f3',
          tint: '#fdf2f8',
          ink: '#831843',
          dot: '#f9a8d4',
        },
        emerald: {
          line: '#d1fae5',
          tint: '#ecfdf5',
          ink: '#064e3b',
          dot: '#6ee7b7',
        },
        peach: {
          line: '#ffedd5',
          tint: '#fff7ed',
          ink: '#7c2d12',
          dot: '#fdba74',
        },
      },
      nav: {
        ink: '#16261c',
        accent: '#1f3d2b',
        muted: 'rgba(22, 38, 28, 0.62)',
        rule: 'rgba(22, 38, 28, 0.13)',
        hover: 'rgba(22, 38, 28, 0.045)',
        surface: '{colors.white}',
        glow: '#96c4a0',
      },
      presence: {
        p0: '#2563c9',
        p1: '#1f7a4f',
        p2: '#a8520b',
        p3: '#7e3fc4',
        p4: '#c0392b',
        p5: '#0f766e',
      },
      switch: {
        on: '#9cc79f',
        off: '#c0c0c0',
      },
      tabbar: '#fcfcfd',
      shadow: '#13251c',
      legacy: {
        shaded: '#fcfcfd',
        input: '{colors.white}',
        blockRef: '#fcfcfc',
      },

      villain: {
        main: '{colors.blue}',
        mainFaded: '#aaaaaa',
        plus: '#222222',
        stripe: '#f7f7f7',
        background: '#000',
        secondary: '{colors.peach}',
        blockBackground: '#ffffff',
        blockBorder: '#9a9a9a26',
        availableBlock: 'rgb(211, 0, 0)',
        availableBlockHover: '#eeeeee',
        popover: '{colors.dark}',
      },
    },

    /* The admin's corners and control heights. css/tokens.css sets
       --brando-radius-* and --brando-control-* from these, so an application
       changes them here, in its own europa.json5:

         radius.sm      badges and small chips
         radius.md      buttons
         radius.lg      inputs and cards
         controls.sm    toolbar and inline buttons
         controls.md    the default button
         controls.lg    a form's Save
         controls.touch every button's minimum on a coarse pointer */
    radius: {
      sm: '4px',
      md: '6px',
      lg: '8px',
    },

    controls: {
      sm: '26px',
      md: '30px',
      lg: '36px',
      touch: '40px',
    },

    /* The admin's shadows, in one ink (colors.shadow, --brando-shadow-ink).
       css/tokens.css sets --brando-shadow-* from these:

         ring     a 1px hairline around a raised surface
         xs       inputs, tabs, a selected segment
         sm       cards and thumbnails
         md       dropdowns, popovers and floating buttons
         lg       menus, toasts, notes and the entry header's panels
         xl       modals and large floating panels
         inset    a field's inner shade
         overlay  the login box's deep lift */
    shadows: {
      ring: '0 0 0 1px color-mix(in srgb, var(--brando-shadow-ink) 6%, transparent)',
      xs: '0 1px 2px color-mix(in srgb, var(--brando-shadow-ink) 6%, transparent)',
      sm: '0 1px 3px color-mix(in srgb, var(--brando-shadow-ink) 12%, transparent)',
      md: '0 4px 16px color-mix(in srgb, var(--brando-shadow-ink) 10%, transparent), 0 1px 3px color-mix(in srgb, var(--brando-shadow-ink) 4%, transparent)',
      lg: '0 8px 24px color-mix(in srgb, var(--brando-shadow-ink) 12%, transparent)',
      xl: '0 16px 48px color-mix(in srgb, var(--brando-shadow-ink) 16%, transparent)',
      inset: 'inset 0 1px 2px color-mix(in srgb, var(--brando-shadow-ink) 4%, transparent)',
      overlay: '0 2.8px 2.2px color-mix(in srgb, var(--brando-shadow-ink) 2%, transparent), 0 6.7px 5.3px color-mix(in srgb, var(--brando-shadow-ink) 2.8%, transparent), 0 12.5px 10px color-mix(in srgb, var(--brando-shadow-ink) 3.5%, transparent), 0 22.3px 17.9px color-mix(in srgb, var(--brando-shadow-ink) 4.2%, transparent), 0 41.8px 33.4px color-mix(in srgb, var(--brando-shadow-ink) 5%, transparent), 0 100px 80px color-mix(in srgb, var(--brando-shadow-ink) 7%, transparent)',
    },

    container: {
      maxWidth: {
        iphone: '100%',
        mobile: '100%',
        ipad_portrait: '100%',
        ipad_landscape: '100%',
        desktop_md: '100%',
        desktop_lg: '100%',
        desktop_xl: '100%',
      },

      padding: {
        iphone: '15px',
        mobile: '15px',
        ipad_portrait: '50px',
        ipad_landscape: '50px',
        desktop_md: '50px',
        desktop_lg: '50px',
        desktop_xl: '50px',
      },
    },

    columns: {
      count: {
        iphone: 6,
        mobile: 6,
        ipad_portrait: 16,
        ipad_landscape: 16,
        desktop_md: 16,
        desktop_lg: 16,
        desktop_xl: 16,
      },
      gutters: {
        iphone: '1vw',
        mobile: '1vw',
        ipad_portrait: '1vw',
        ipad_landscape: '1vw',
        desktop_md: '1vw',
        desktop_lg: '1vw',
        desktop_xl: '1vw',
      },
    },

    typography: {
      /* `base` is the px value of 1rem set as font-size on the html element. */
      base: '20px',

      /* Line height per breakpoint: the default multiplier for
         `vertical-rhythm()` when its second argument is omitted. */
      lineHeight: {
        iphone: 1.35,
        mobile: 1.35,
        ipad_portrait: 1.35,
        ipad_landscape: 1.35,
        desktop_md: 1.35,
        desktop_lg: 1.35,
        desktop_xl: 1.35,
      },

      /* main font sizing map */
      sizes: {
        button: {
          iphone: '15px',
          mobile: '15px',
          ipad_portrait: '17px',
          ipad_landscape: '17px',
          desktop_md: '18px',
          desktop_lg: '18px',
          desktop_xl: '19px',
        },

        form: {
          help: {
            iphone: '9px',
            mobile: '9px',
            ipad_portrait: '11px',
            ipad_landscape: '11px',
            desktop_md: '11px',
            desktop_lg: '11px',
            desktop_xl: '12px',
          },

          label: {
            iphone: '14px',
            mobile: '14px',
            ipad_portrait: '15px',
            ipad_landscape: '15px',
            desktop_md: '15px',
            desktop_lg: '15px',
            desktop_xl: '16px',
          },
        },

        nav: {
          section: {
            iphone: {
              'font-size': '12px',
              'line-height': '140%',
            },
            mobile: {
              'font-size': '12px',
              'line-height': '140%',
            },
            ipad_portrait: {
              'font-size': '12px',
              'line-height': '140%',
            },
            ipad_landscape: {
              'font-size': '12px',
              'line-height': '140%',
            },
            desktop_md: {
              'font-size': '12px',
              'line-height': '140%',
            },
            desktop_lg: {
              'font-size': '12px',
              'line-height': '140%',
            },
            desktop_xl: {
              'font-size': '12px',
              'line-height': '140%',
            },
          },
          mainItem: {
            iphone: {
              'font-size': '24px',
              'line-height': '36px',
            },
            mobile: {
              'font-size': '24px',
              'line-height': '36px',
            },
            ipad_portrait: {
              'font-size': '23px',
              'line-height': '34px',
            },
            ipad_landscape: {
              'font-size': '26px',
              'line-height': '34px',
            },
            desktop_md: {
              'font-size': '26px',
              'line-height': '34px',
            },
            desktop_lg: {
              'font-size': '26px',
              'line-height': '34px',
            },
            desktop_xl: {
              'font-size': '26px',
              'line-height': '34px',
            },
          },
        },

        /* this is per SIZE followed by per BREAKPOINT */
        '2xs': {
          iphone: '9px',
          mobile: '9px',
          ipad_portrait: '10px',
          ipad_landscape: '10px',
          desktop_md: '10px',
          desktop_lg: '12px',
          desktop_xl: '13px',
        },

        xs: {
          iphone: '12px',
          mobile: '12px',
          ipad_portrait: '12px',
          ipad_landscape: '12px',
          desktop_md: '12px',
          desktop_lg: '13px',
          desktop_xl: '14px',
        },

        sm: {
          iphone: '16px',
          mobile: '16px',
          ipad_portrait: '16px',
          ipad_landscape: '1.1111111111111112vw',
          desktop_md: '1.1111111111111112vw',
          desktop_lg: '16px',
          desktop_xl: '16px',
        },

        input: {
          iphone: '16px',
          mobile: '16px',
          ipad_portrait: '16px',
          ipad_landscape: '16px',
          desktop_md: '16px',
          desktop_lg: '16px',
          desktop_xl: '18px',
        },

        lede: {
          iphone: '18px',
          mobile: '18px',
          ipad_portrait: '24px',
          ipad_landscape: '24px',
          desktop_md: '26px',
          desktop_lg: '27px',
          desktop_xl: '28px',
        },

        base: {
          iphone: {
            'font-size': '16px',
            'line-height': '1.4',
          },
          mobile: {
            'font-size': '16px',
            'line-height': '1.4',
          },
          ipad_portrait: {
            'font-size': '18px',
            'line-height': '1.4',
          },
          ipad_landscape: {
            'font-size': '18px',
            'line-height': '1.4',
          },
          desktop_md: {
            'font-size': '20px',
            'line-height': '1.4',
          },
          desktop_lg: {
            'font-size': '20px',
            'line-height': '1.4',
          },
          desktop_xl: {
            'font-size': '23px',
            'line-height': '1.4',
          },
        },

        badge: {
          iphone: '10px',
          mobile: '10px',
          ipad_portrait: '10px',
          ipad_landscape: '11px',
          desktop_md: '11px',
          desktop_lg: '12px',
          desktop_xl: '12px',
        },

        lg: {
          iphone: {
            'font-size': '24px',
          },
          mobile: {
            'font-size': '24px',
          },
          ipad_portrait: {
            'font-size': '24px',
          },
          ipad_landscape: {
            'font-size': '30px',
          },
          desktop_md: {
            'font-size': '30px',
          },
          desktop_lg: {
            'font-size': '30px',
          },
          desktop_xl: {
            'font-size': '30px',
          },
        },

        xl: {
          //
          iphone: {
            'font-size': '24px',
            'font-weight': '200',
          },
          mobile: {
            'font-size': '24px',
            'font-weight': '200',
          },
          ipad_portrait: {
            'font-size': '28px',
            'font-weight': '200',
          },
          ipad_landscape: {
            'font-size': '32px',
            'font-weight': '200',
          },
          desktop_md: {
            'font-size': '36px',
            'font-weight': '200',
          },
          desktop_lg: {
            'font-size': '40px',
            'font-weight': '200',
          },
          desktop_xl: {
            'font-size': '40px',
            'font-weight': '200',
          },
        },

        h1: {
          iphone: {
            'font-size': '27px',
            'font-weight': '600',
          },
          mobile: {
            'font-size': '30px',
            'font-weight': '600',
          },
          ipad_portrait: {
            'font-size': '30px',
            'font-weight': '600',
          },
          ipad_landscape: {
            'font-size': '30px',
            'font-weight': '600',
          },
          desktop_md: {
            'font-size': '50px',
            'font-weight': '600',
          },
          desktop_lg: {
            'font-size': '55px',
            'font-weight': '600',
          },
          desktop_xl: {
            'font-size': '65px',
            'font-weight': '600',
          },
        },

        h2: {
          //
          iphone: {
            'font-size': '22px',
            'font-weight': '600',
          },
          mobile: {
            'font-size': '24px',
            'font-weight': '600',
          },
          ipad_portrait: {
            'font-size': '27px',
            'font-weight': '600',
          },
          ipad_landscape: {
            'font-size': '30px',
            'font-weight': '600',
          },
          desktop_md: {
            'font-size': '32px',
            'font-weight': '600',
          },
          desktop_lg: {
            'font-size': '35px',
            'font-weight': '600',
          },
          desktop_xl: {
            'font-size': '35px',
            'font-weight': '600',
          },
        },

        h3: {
          iphone: {
            'font-size': '21px',
          },
          mobile: {
            'font-size': '22px',
          },
          ipad_portrait: {
            'font-size': '23px',
          },
          ipad_landscape: {
            'font-size': '24px',
          },
          desktop_md: {
            'font-size': '27px',
          },
          desktop_lg: {
            'font-size': '28px',
          },
          desktop_xl: {
            'font-size': '30px',
          },
        },

        '3xl': {
          //
          iphone: '36px',
          mobile: '36px',
          ipad_portrait: '41px',
          ipad_landscape: '41px',
          desktop_md: '51px',
          desktop_lg: '57px',
          desktop_xl: '80px',
        },

        '4xl': {
          //
          iphone: '35px',
          mobile: '40px',
          ipad_portrait: '45px',
          ipad_landscape: '50px',
          desktop_md: '62px',
          desktop_lg: '79px',
          desktop_xl: '90px',
        },
      },

      /* Declaration maps per breakpoint, applied with
         `@unpack theme.typography.sections.NAME;`. */
      sections: {
        navigation: {
          iphone: {
            'font-size': '55px',
            'line-height': '1',
          },
          mobile: {
            'font-size': '55px',
            'line-height': '1',
          },

          desktop_md: {
            'font-size': '55px',
            'line-height': '1',
          },

          desktop_lg: {
            'font-size': '55px',
            'line-height': '1',
          },

          desktop_xl: {
            'font-size': '55px',
            'line-height': '1',
          },
        },
      },

      families: {
        main: [
          'Main',
          '-apple-system',
          'BlinkMacSystemFont',
          '"Segoe UI"',
          'Roboto',
          '"Helvetica Neue"',
          'Arial',
          'sans-serif',
        ],

        blocks: ['Blocks'],

        mono: [
          'Mono',
          'Menlo',
          'Monaco',
          'Consolas',
          '"Liberation Mono"',
          '"Courier New"',
          'monospace',
        ],
      },
    },

    spacing: {
      '3xs': {
        iphone: '15px',
        mobile: '15px',
        ipad_portrait: '20px',
        ipad_landscape: '20px',
        desktop_md: '20px',
        desktop_lg: '25px',
        desktop_xl: '25px',
      },
      '2xs': {
        iphone: '15px',
        mobile: '15px',
        ipad_portrait: '20px',
        ipad_landscape: '20px',
        desktop_md: '25px',
        desktop_lg: '30px',
        desktop_xl: '40px',
      },
      xs: {
        iphone: '15px',
        mobile: '15px',
        ipad_portrait: '15px',
        ipad_landscape: '15px',
        desktop_md: '15px',
        desktop_lg: '15px',
        desktop_xl: '15px',
      },
      sm: {
        iphone: '25px',
        mobile: '25px',
        ipad_portrait: '25px',
        ipad_landscape: '25px',
        desktop_md: '25px',
        desktop_lg: '25px',
        desktop_xl: '25px',
      },
      md: {
        iphone: '50px',
        mobile: '50px',
        ipad_portrait: '50px',
        ipad_landscape: '50px',
        desktop_md: '50px',
        desktop_lg: '50px',
        desktop_xl: '50px',
      },
      lg: {
        iphone: '100px',
        mobile: '100px',
        ipad_portrait: '100px',
        ipad_landscape: '100px',
        desktop_md: '100px',
        desktop_lg: '100px',
        desktop_xl: '100px',
      },
      xl: {
        iphone: '65px',
        mobile: '65px',
        ipad_portrait: '65px',
        ipad_landscape: '85px',
        desktop_md: '100px',
        desktop_lg: '150px',
        desktop_xl: '180px',
      },
      '2xl': {
        iphone: '140px',
        mobile: '140px',
        ipad_portrait: '120px',
        ipad_landscape: '160px',
        desktop_md: '190px',
        desktop_lg: '250px',
        desktop_xl: '300px',
      },
    },
  },
}
